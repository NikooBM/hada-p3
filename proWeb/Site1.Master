<%@ Master Language="C#" AutoEventWireup="true"
    CodeBehind="Site1.Master.cs" Inherits="proWeb.Site1" %>
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title>HADA P3</title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <style type="text/css">
        * { box-sizing: border-box; }
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            background: #fff;
        }
        .top-bar {
            padding: 6px 14px;
            font-size: 13px;
            background: #f0f0f0;
            border-bottom: 1px solid #ddd;
        }
        .header-banner {
            background-color: #4DB6AC;
            color: white;
            text-align: center;
            padding: 22px 10px;
        }
        .header-banner h1 {
            margin: 0;
            font-size: 28px;
            letter-spacing: 1px;
        }
        .content {
            padding: 18px 24px;
        }
    </style>
</head>
<body>
    <form id="form1" runat="server">

        <%-- Sección superior: nombre y NIF/NIE --%>
        <div class="top-bar">
            Nikoloz Bibileishvili Mamaladze - 78008606N
            Abdelilah Taalba Alouani - 49252801A
        </div>

        <%-- Banner de cabecera con h1 --%>
        <div class="header-banner">
            <h1>HADA P3 - CURSO 2025/26</h1>
        </div>

        <%-- Zona de contenido de cada página derivada --%>
        <div class="content">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </div>

    </form>
</body>
</html>
